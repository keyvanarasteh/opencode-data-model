#!/usr/bin/env bash
#MISE description="Build the project"
#MISE sources=["src/**/*"]
#MISE outputs=["dist/index.js", "dist/index.d.ts", "dist/command/data-model.md"]

rm -rf dist
bun build ./src/index.ts --outdir dist --target bun
tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false
find dist -name '*.test.d.ts' -delete
mkdir -p dist/command
cp src/command/*.md dist/command/
