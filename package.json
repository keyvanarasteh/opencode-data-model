{
  "name": "opencode-data-model",
  "version": "1.0.0",
  "description": "OpenCode plugin for generating data model documentation, database schemas, and TypeScript or JavaScript models",
  "author": {
    "name": "Keyvan Arasteh",
    "email": "keyvan.arasteh@live.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keyvanarasteh/opencode-data-model.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "data-model",
    "schema",
    "mysql",
    "postgresql",
    "typescript",
    "javascript"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "1.0.85"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "8.47.0",
    "@typescript-eslint/parser": "8.47.0",
    "bun-types": "latest",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "sql-ddl-to-json-schema": "^6.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
}
